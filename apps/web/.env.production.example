# ── Frontend en producción · Hostinger (Web App separada) ─────────────
# Copia estos valores en hPanel → Web App (Frontend) → Environment variables.
# Las NEXT_PUBLIC_* se incrustan en build time: si cambian, pulsa Redeploy.

# URL pública de la API. El navegador la usa para pedidos y para el panel.
# Debe ser absoluta, HTTPS y SIN barra final.
NEXT_PUBLIC_API_URL="https://api.tudominio.com"

# URL que usa el servidor de Next (RSC/SSR) para leer catálogo y configuración.
# En Hostinger las dos Web Apps no comparten localhost: usa la URL pública.
API_INTERNAL_URL="https://api.tudominio.com"

NEXT_PUBLIC_STORE_THEME="joyeria"
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
