# ── Frontend local (Next.js) ──────────────────────────────────────────
# Copia este archivo como apps/web/.env.local para desarrollo.

# Navegador: URL pública de la API.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Servidor (RSC/SSR): URL interna de la API.
API_INTERNAL_URL="http://localhost:3001"

# Rubro visual activo: joyeria | moda | tech.
NEXT_PUBLIC_STORE_THEME=joyeria
