# ── API en producción · Hostinger (Web App separada) ──────────────────
# Copia estos valores en hPanel → Web App (API) → Environment variables.
# No definas PORT: Hostinger lo inyecta y la API lee process.env.PORT.

# Base de datos MySQL de Hostinger.
# Usa el host, puerto, usuario y base que muestra hPanel.
DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/BASEDATOS?connection_limit=5"

NODE_ENV="production"

# Dominios exactos del frontend (sin barra final).
# Incluye el dominio temporal de Hostinger si vas a probar antes de asignar el dominio final.
CORS_ORIGIN="https://tudominio.com,https://www.tudominio.com"

# Panel de administración (obligatorio en producción).
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-contraseña-larga-y-segura"
ADMIN_NAME="Administrador"
ADMIN_JWT_SECRET="cadena-aleatoria-de-64-caracteres-minimo"
ADMIN_TOKEN_TTL_HOURS="12"
