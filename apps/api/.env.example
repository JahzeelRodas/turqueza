# ── API local (NestJS) ────────────────────────────────────────────────
# Copia este archivo como apps/api/.env para desarrollo.
# En Hostinger NO subas este archivo: define las variables en hPanel.

# MySQL local o el servicio `db` de docker-compose.
DATABASE_URL="mysql://store:store@localhost:3306/store?connection_limit=5"

# Hostinger inyecta PORT en producción. En local usa 3001.
PORT=3001

# Orígenes del frontend para CORS (separados por coma, sin barra final).
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Panel de administración. Cambia estos valores antes de producción.
ADMIN_EMAIL=admin@turquesa.bo
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
ADMIN_JWT_SECRET=test-secret-turquesa-cadena-local
ADMIN_TOKEN_TTL_HOURS=12
