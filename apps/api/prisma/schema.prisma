// ─────────────────────────────────────────────────────────────────────────
// Plataforma e-commerce headless · MySQL + Prisma
//
// Diseño "agnóstico al rubro":
//  · `metadata` (JSON)  → atributos dinámicos propios de cada sector.
//    Ej. joyería: { material, piedra, quilates } · ropa: { talla, color }.
//  · `attributes` (JSON) → flags/config del producto para la UI:
//    { badges: string[], hasSizeGuide: boolean, ... }.
//  · `engraving` (JSON) → configuración del asistente de grabado por producto:
//    { enabled, price, maxChars, fonts: [...], placements: [...] }.
//  · `variants`          → SKUs concretos con stock y precio override.
//  · `StoreConfig`       → tema visual + layout de bloques (JSON) por tienda.
//
// Zona de envío: tabla `ShippingZone` con los 9 departamentos de Bolivia.
// El checkout de WhatsApp vive en el storefront; la API expone la orden y
// `whatsappUrl` ya formateada (ver apps/api/src/common/whatsapp.ts).
//
// NOTA (MySQL): no existen arrays escalares ni `JsonB`. `images`, `tags` y
// `cities` se guardan como arrays JSON y la API los normaliza a `string[]`.
// MySQL no permite índices GIN: para búsquedas intensivas sobre JSON usa
// columnas generadas o full-text; el catálogo actual filtra por columnas
// relacionales normales.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING // creado en la web, aún no confirmado
  CONFIRMED_WHATSAPP // el cliente ya envió el mensaje por WhatsApp
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ── Catálogo ───────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  // Estructura en árbol (Categorías → Subcategorías)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  subtitle       String?
  description    String?       @db.Text
  // Dinero en céntimos (evita floats); p.ej. 129000 = 1.290,00 Bs
  price          Int
  compareAtPrice Int? // precio tachado para ofertas
  currency       String        @default("BOB")
  /// Array JSON de URLs (MySQL no soporta String[]).
  images         Json
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  stock          Int           @default(0)
  /// Array JSON de etiquetas.
  tags           Json

  /// Atributos dinámicos del rubro (JSON): material, talla, quilates, color...
  metadata   Json
  /// Flags de UI para la ficha de producto (JSON): { badges, hasSizeGuide }
  attributes Json
  /// Configuración del grabado láser (JSON). null = no personalizable.
  engraving  Json?

  categoryId String?
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@index([status, isFeatured])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String  @unique
  name           String // "Anillo Aurora · Oro rosa · 52"
  price          Int? // si es null usa Product.price (override)
  compareAtPrice Int? // precio original de la variante para ofertas
  stock          Int     @default(0)
  isActive       Boolean @default(true)
  position       Int     @default(0)
  imageUrl       String?

  /// Opciones dinámicas (JSON): { talla: "52" } / { color: "Negro" }
  options Json

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ── Carrito (persistencia opcional; el storefront también soporta localStorage) ──

model Cart {
  id        String    @id @default(cuid())
  token     String    @unique // cookie/sessionId anónimo
  email     String?
  currency  String    @default("BOB")
  expiresAt DateTime?

  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([token])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity  Int   @default(1)
  /// Especificaciones del grabado (JSON): { enabled, text, font, placement, price }
  engraving Json?

  @@index([cartId])
}

// ── Envíos nacionales (Bolivia) ────────────────────────────────────────────

model ShippingZone {
  id            String  @id @default(cuid())
  code          String  @unique // "LP", "SC", ...
  department    String  @unique // "La Paz", "Santa Cruz", ...
  /// Array JSON de ciudades (MySQL no soporta String[]).
  cities        Json
  price         Int // céntimos de BOB
  freeThreshold Int? // subtotal mínimo para envío gratis (céntimos)
  estimatedDays String  @default("2-4 días hábiles")
  isActive      Boolean @default(true)
  position      Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// ── Pedidos ────────────────────────────────────────────────────────────────

model Order {
  id           String  @id @default(cuid())
  orderNumber  String  @unique
  email        String
  customerName String
  phone        String?
  notes        String? @db.Text

  /// Snapshot de la dirección de envío (JSON): fullName, line1, city, department...
  shippingAddress Json
  status          OrderStatus @default(PENDING)

  /// Departamento de envío (snapshot legible) + zona usada para el costo
  shippingDepartment String?
  shippingZoneId     String?
  shippingZone       ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)

  // Dinero en céntimos
  subtotal Int
  shipping Int    @default(0)
  total    Int
  currency String @default("BOB")

  /// Mensaje exacto enviado a WhatsApp (auditoría del checkout)
  whatsappMessage String? @db.Text

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([shippingZoneId])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Opcionales: el pedido conserva el snapshot aunque se borre el producto
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot del producto vendido
  name      String
  sku       String
  unitPrice Int
  quantity  Int
  total     Int
  /// Opciones del variant compradas (JSON): { talla: "52" }
  options   Json

  /// Especificaciones exactas del grabado láser (JSON):
  /// { enabled, text, font, placement, price }
  engraving Json?

  @@index([orderId])
}

// ── Configuración de tienda (singleton) ───────────────────────────────────

model StoreConfig {
  id             String  @id @default("singleton")
  storeName      String
  tagline        String?
  domain         String? @unique
  currency       String  @default("BOB")
  locale         String  @default("es-BO")
  country        String  @default("Bolivia")
  /// WhatsApp de la joyería en formato internacional sin "+" (ej. 59171234567)
  whatsappNumber String?
  /// ID del tema visual activo (registro de temas en apps/web/src/config/store-theme.ts)
  themeId        String  @default("joyeria")

  /// JSON: navegación/mega menú, footer, sellos de confianza y layout de bloques
  navigation Json
  footer     Json
  valueProps Json
  homeLayout Json

  updatedAt DateTime @updatedAt
}
