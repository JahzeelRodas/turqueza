# ── Producción · Hostinger con backend y frontend separados ───────────
# En el hosting gestionado estas variables se definen en hPanel
# (Web App → Environment variables), no en archivos .env del repo.
#
# Guía completa: docs/HOSTINGER.md
#
# Este archivo es solo una referencia rápida. Usa los ejemplos por app:
#   apps/api/.env.production.example
#   apps/web/.env.production.example

# ── Web App 1 · API (root: apps/api · api.tudominio.com) ───────────────
DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/BASEDATOS?connection_limit=5"
NODE_ENV=production
CORS_ORIGIN="https://tudominio.com,https://www.tudominio.com"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-contraseña-larga-y-segura"
ADMIN_NAME="Administrador"
ADMIN_JWT_SECRET="cadena-aleatoria-de-64-caracteres-minimo"
ADMIN_TOKEN_TTL_HOURS=12
# No definas PORT: Hostinger lo inyecta.

# ── Web App 2 · Frontend (root: apps/web · tudominio.com) ──────────────
NEXT_PUBLIC_API_URL="https://api.tudominio.com"
API_INTERNAL_URL="https://api.tudominio.com"
NEXT_PUBLIC_STORE_THEME=joyeria
NEXT_TELEMETRY_DISABLED=1
