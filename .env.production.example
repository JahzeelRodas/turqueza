# ── Producción · Hostinger Business (Node.js nativo) ──────────────────
# En el hosting gestionado estas variables se definen en hPanel
# (Web App → Environment variables), no en archivos .env del repo.
# Ver docs/CI-CD.md.

# API (apps/api/.env)
# Hostinger MySQL: normalmente host "localhost" y nombres con prefijo de cuenta.
DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/BASEDATOS?connection_limit=5"
NODE_ENV=production
CORS_ORIGIN="https://tudominio.com,https://www.tudominio.com"

# Panel de administración (cambiar obligatoriamente)
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-contraseña-larga-y-segura"
ADMIN_NAME="Administrador"
ADMIN_JWT_SECRET="cadena-aleatoria-de-64-caracteres-minimo"
ADMIN_TOKEN_TTL_HOURS=12

# Gateway / Web (raíz del monorepo)
# Una sola Web App: NO definas NEXT_PUBLIC_API_URL; el navegador usa /api del mismo origen.
# Si usas dos Web Apps, define NEXT_PUBLIC_API_URL y API_INTERNAL_URL con la URL pública
# de la API (https://api.tudominio.com).
API_INTERNAL_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_STORE_THEME=joyeria

# Opcional: solo en el primer arranque para cargar catálogo, zonas y admin.
# RUN_SEED=true
# RUN_MIGRATIONS=true
