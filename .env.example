# Copia este archivo como apps/api/.env y apps/web/.env.local.
# Cada app carga sus variables desde su propio directorio.
#
# ── Base de datos (MySQL, Prisma) ─────────────────────────────────────
# Local: host "localhost" · Docker Compose: host "db"
# Hostinger: usa el host, usuario y base que aparecen en hPanel.
DATABASE_URL="mysql://store:store@localhost:3306/store?connection_limit=5"

MYSQL_USER=store
MYSQL_PASSWORD=store
MYSQL_ROOT_PASSWORD=store
MYSQL_DATABASE=store

# ── API (NestJS) ──────────────────────────────────────────────────────
PORT=3001
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# ── Panel de administración ───────────────────────────────────────────
# Credenciales del panel /admin. CÁMBIALAS antes de producción.
ADMIN_EMAIL=admin@turquesa.bo
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
# Secreto para firmar los tokens de sesión (usa una cadena larga y aleatoria).
ADMIN_JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
# Duración de la sesión en horas.
ADMIN_TOKEN_TTL_HOURS=12

# ── Web (Next.js) ─────────────────────────────────────────────────────
# Navegador: URL pública de la API. Vacío => mismo origen (proxy /api de Nginx).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Servidor (RSC/SSR): URL interna de la API en el mismo servidor.
API_INTERNAL_URL=http://localhost:3001
# Rubro visual activo: joyeria | moda | tech (ver apps/web/src/config/store-theme.ts)
NEXT_PUBLIC_STORE_THEME=joyeria

# ── WhatsApp (opcional; también se guarda en StoreConfig) ─────────────
# Formato internacional sin "+" ni espacios.
STORE_WHATSAPP_NUMBER=59171234567
